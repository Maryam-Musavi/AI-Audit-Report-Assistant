d><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-noc-c3="" style="color: #055274;">۸۲,۷۱۹,۳۶۵ </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-noc-c3="" style="color: #055274;">۱۰۵,۷۸۰,۶۴۸ </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-noc-c3="" style="color: #055274;">۲۱۸,۷۹۸,۹۱۷ </span></td></tr><tr _ngcontent-noc-c3=""><!----><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-noc-c3="" style="color: #055274;">جمع </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-noc-c3="" style="color: #055274;">۳,۰۰۰,۵۹۲,۹۸۶ </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-noc-c3="" style="color: #055274;">۴,۲۱۱,۵۱۱,۳۳۳ </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-noc-c3="" style="color: #055274;">۵,۵۲۶,۱۴۷,۳۷۶ </span></td></tr><tr _ngcontent-noc-c3=""><!----><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="right-aligne"><span _ngcontent-noc-c3="" style="color: #055274;">هزينه جذب نشده درتوليد </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-noc-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-noc-c3="" style="color: #055274;">۰ </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class=""><span _ngcontent-noc-c3="" style="color: #055274;">۰ </span></td></tr><tr _ngcontent-noc-c3=""><!----><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="dynamic_comp right-aligne"><span _ngcontent-noc-c3="" style="color: #055274;">جمع هزينه هاي توليد </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="dynamic_comp"><span _ngcontent-noc-c3="" style="color: #055274;">۳,۰۰۰,۵۹۲,۹۸۶ </span></td><td _ngcontent-noc-c3="" rowspan="1" colspan="1" class="dyna