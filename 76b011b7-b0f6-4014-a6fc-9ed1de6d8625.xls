<!----><app-statement _ngcontent-jsg-c0="" _nghost-jsg-c1=""><div _ngcontent-jsg-c1="" style="direction: rtl;"><!----><div _ngcontent-jsg-c1=""><!----><div _ngcontent-jsg-c1="" class="sheet-container"><app-sheet _ngcontent-jsg-c1="" _nghost-jsg-c2=""><!----><div _ngcontent-jsg-c2="" class="table-containet"><!----><div _ngcontent-jsg-c2="" class="table-title ng-binding ng-scope">صورت سود و زيان</div><!----><div _ngcontent-jsg-c2="" class="table-description ng-binding ng-scope">کليه مبالغ به ميليون ريال است</div><app-table _ngcontent-jsg-c2="" _nghost-jsg-c3=""><table _ngcontent-jsg-c3="" class="rayanDynamicStatement"><thead _ngcontent-jsg-c3=""><!----><tr _ngcontent-jsg-c3=""><!----><th _ngcontent-jsg-c3="" rowspan="2" colspan="1"><span _ngcontent-jsg-c3="">شرح</span></th><th _ngcontent-jsg-c3="" rowspan="1" colspan="1"><span _ngcontent-jsg-c3="">دوره منتهي به ۱۴۰۳/۱۲/۳۰</span></th><th _ngcontent-jsg-c3="" rowspan="1" colspan="1"><span _ngcontent-jsg-c3="">تجديد ارائه شده دوره منتهي به ۱۴۰۲/۱۲/۲۹</span></th><th _ngcontent-jsg-c3="" rowspan="2" colspan="1"><span _ngcontent-jsg-c3="">درصد تغيير</span></th></tr><tr _ngcontent-jsg-c3=""><!----><th _ngcontent-jsg-c3="" rowspan="1" colspan="1"><span _ngcontent-jsg-c3="">حسابرسی شده</span></th><th _ngcontent-jsg-c3="" rowspan="1" colspan="1"><span _ngcontent-jsg-c3="">حسابرسی شده</span></th></tr></thead><tbody _ngcontent-jsg-c3=""><!----><tr _ngcontent-jsg-c3=""><!----><td _ngcontent-jsg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jsg-c3="" style="color: #055274;">عمليات در حال تداوم: </span></td><td _ngcontent-jsg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jsg-c3="" style="color: #055274;"> </span></td><td _ngcontent-jsg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jsg-c3="" style="color: #055274;"> </span></td><td _ngcontent-jsg-c3="" rowspan="1" colspan="1" class="dynamic_desc right-aligne"><span _ngcontent-jsg-